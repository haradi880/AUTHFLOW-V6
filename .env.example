APP_ENV=production
FLASK_APP=run.py
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://authflow:authflow@postgres:5432/authflow
APP_NAME=AUTHFLOW
PUBLIC_BASE_URL=https://haradibots.onrender.com
RATELIMIT_STORAGE_URI=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_ASYNC=true
UPLOAD_FOLDER=uploads
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT=10
MAIL_FORCE_IPV4=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
MAIL_SENDER_NAME=AUTHFLOW

# Email fallback chain. On hosts where SMTP is blocked, set
# EMAIL_DELIVERY_ORDER=resend,smtp,file and add RESEND_API_KEY.
EMAIL_BACKEND=auto
EMAIL_DELIVERY_ORDER=smtp,backup_smtp,resend,sendgrid,file
EMAIL_FILE_FALLBACK=false
EMAIL_OUTBOX_FOLDER=logs/email_outbox
MAIL_BACKUP_SERVER=
MAIL_BACKUP_PORT=587
MAIL_BACKUP_USE_TLS=true
MAIL_BACKUP_USE_SSL=false
MAIL_BACKUP_USERNAME=
MAIL_BACKUP_PASSWORD=
MAIL_BACKUP_DEFAULT_SENDER=
RESEND_API_KEY=
RESEND_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM=

# Supabase Storage backup upload. Use a service-role key on the server only.
SUPABASE_URL=
SUPABASE_KEY=
UPLOAD_STORAGE_BUCKET=uploads
BACKUP_STORAGE_BUCKET=backups
BACKUP_KEEP_LOCAL=20
ADMIN_PASSWORD=change-me-admin
WTF_CSRF_ENABLED=true
SESSION_DAYS=30
REMEMBER_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
ITEMS_PER_PAGE=12
JWT_EXPIRATION_HOURS=24
